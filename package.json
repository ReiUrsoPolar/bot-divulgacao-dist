{
  "name": "bot-divulgacao",
  "version": "1.0.0",
  "description": "Bot de divulgação em massa para WhatsApp",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "bash start.sh",
    "dev":   "node --env-file=.env index.js",
    "build": "node build/build.js",
    "publish": "node build/build.js --push",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/@whiskeysockets/baileys/lib/Socket/messages-send.js';function p(d,o,n){try{let c=fs.readFileSync(f,'utf8');if(c.includes(n)){console.log('[patch] OK:',d);return}if(!c.includes(o)){console.log('[patch] miss:',d);return}fs.writeFileSync(f,c.replace(o,n),'utf8');console.log('[patch] Applied:',d)}catch(e){console.log('[patch] skip:',d,e.message)}}p('lid.split','me?.lid.split(','me?.lid?.split(');\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@whiskeysockets/baileys": "6.7.21",
    "axios": "^1.7.2",
    "better-sqlite3": "^12.9.0",
    "colors": "^1.4.0",
    "node-cache": "^5.1.2",
    "pino": "^9.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3"
  }
}
